# ==========================================
# Siftly — Environment Configuration
# ==========================================

# Google Gemini API Key
# Required for query understanding, candidate extraction, and intelligent ranking.
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key
# Required for live web product discovery and multi-store verification.
# Get your API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# App URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SerpApi key (recommended) — enables Google Shopping results:
# real products, real prices, and a real multi-store comparison with offers.
# Without it, Siftly falls back to Tavily web search (less accurate).
# Get a key at: https://serpapi.com
SERPAPI_API_KEY=your_serpapi_key_here

# Optional: Gemini model to try first (e.g. gemini-flash-latest)
# GEMINI_MODEL=

# Supabase (accounts: sign up / sign in, synced chats, pins and saved items)
# 1. Create a project at https://supabase.com
# 2. Run supabase/schema.sql in the Supabase SQL Editor
# 3. Copy these from Project Settings -> API
# Without them, Siftly runs in guest mode (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# "Continue with Google" needs Google enabled under Authentication -> Providers in Supabase.
# Set to false to hide the button.
# NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED=true

# Free plan: searches per person per day (guests by IP, signed-in users by account). Default 5.
# SEARCH_LIMIT_PER_DAY=5
# Optional: different limits for guests / signed-in users, and the window length
# SEARCH_LIMIT_GUEST_PER_DAY=5
# SEARCH_LIMIT_USER_PER_DAY=5
# SEARCH_LIMIT_WINDOW_HOURS=24
