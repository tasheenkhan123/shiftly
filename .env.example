# ==========================================
# Siftly — Environment Configuration
# ==========================================

# Google Gemini API Key
# Required for query understanding, candidate extraction, and intelligent ranking.
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search API Key
# Required for live web product discovery and multi-store verification.
# Get your API key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# App URL (optional, defaults to http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
